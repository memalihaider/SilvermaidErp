// Silver Maid ERP - Database Schema
// Schedule-Driven Service Operations Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          UserRole  @default(STAFF)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  // Relations
  staff         Staff?
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// STAFF MANAGEMENT
// ============================================

enum Skill {
  RESIDENTIAL
  COMMERCIAL
  DEEP_CLEAN
  CARPET_CLEANING
  WINDOW_CLEANING
  POST_CONSTRUCTION
  MOVE_IN_OUT
}

model Staff {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String    @unique
  phone           String
  emergencyContact String?
  address         String?
  skills          Skill[]
  hourlyRate      Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  hireDate        DateTime  @default(now())
  terminatedAt    DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  availability    StaffAvailability[]
  bookingStaff    BookingStaff[]
  performanceMetrics StaffPerformance[]

  @@map("staff")
}

model StaffAvailability {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int      // 0 = Sunday, 6 = Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)

  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_availability")
}

model StaffPerformance {
  id              String   @id @default(cuid())
  staffId         String
  month           DateTime // First day of month
  completedJobs   Int      @default(0)
  cancelledJobs   Int      @default(0)
  avgRating       Decimal? @db.Decimal(3, 2)
  totalHours      Decimal  @db.Decimal(10, 2) @default(0)
  onTimeRate      Decimal? @db.Decimal(5, 2) // Percentage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month])
  @@map("staff_performance")
}

// ============================================
// CUSTOMER MANAGEMENT
// ============================================

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

model Customer {
  id          String       @id @default(cuid())
  type        CustomerType @default(RESIDENTIAL)
  name        String
  email       String?
  phone       String
  companyName String?      // For commercial customers
  taxId       String?      // VAT registration number
  notes       String?      @db.Text
  preferences String?      @db.Text // JSON stored as text for flexibility
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?    // Soft delete

  // Relations
  addresses   CustomerAddress[]
  bookings    Booking[]

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  label       String   @default("Home") // Home, Office, etc.
  street      String
  building    String?
  floor       String?
  apartment   String?
  area        String
  city        String   @default("Dubai")
  emirate     String   @default("Dubai")
  country     String   @default("UAE")
  coordinates String?  // "lat,lng" for mapping
  notes       String?  @db.Text // Access instructions, parking, etc.
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@map("customer_addresses")
}

// ============================================
// SERVICES
// ============================================

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  basePrice       Decimal  @db.Decimal(10, 2)
  priceUnit       String   @default("flat") // flat, hourly, per_sqm
  durationMinutes Int      // Estimated duration
  minCrewSize     Int      @default(1)
  maxCrewSize     Int      @default(1)
  requiredSkills  Skill[]
  vatRate         Decimal  @db.Decimal(5, 2) @default(5) // UAE VAT is 5%
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // Soft delete

  // Relations
  bookings        Booking[]

  @@map("services")
}

// ============================================
// BOOKINGS (Central Entity)
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  PHONE
  WALK_IN
  REFERRAL
  REPEAT
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique // BK-2024-00001
  customerId      String
  serviceId       String
  addressId       String
  
  // Scheduling
  scheduledDate   DateTime      // Date of service
  scheduledTime   String        // "09:00"
  durationMinutes Int           // Actual duration (may differ from service default)
  endTime         String        // Calculated end time "11:00"
  
  // Status
  status          BookingStatus @default(PENDING)
  source          BookingSource @default(WEBSITE)
  
  // Pricing
  basePrice       Decimal       @db.Decimal(10, 2)
  adjustments     Decimal       @db.Decimal(10, 2) @default(0) // Discounts or extras
  vatAmount       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  
  // Additional Info
  specialRequests String?       @db.Text
  internalNotes   String?       @db.Text
  customerRating  Int?          // 1-5
  customerFeedback String?      @db.Text
  
  // Timestamps
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // Soft delete

  // Relations
  customer        Customer      @relation(fields: [customerId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  address         CustomerAddress @relation(fields: [addressId], references: [id])
  staff           BookingStaff[]
  invoice         Invoice?

  @@index([scheduledDate])
  @@index([status])
  @@index([customerId])
  @@map("bookings")
}

model BookingStaff {
  id        String   @id @default(cuid())
  bookingId String
  staffId   String
  isLead    Boolean  @default(false) // Lead cleaner
  
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id])

  @@unique([bookingId, staffId])
  @@map("booking_staff")
}

// ============================================
// INVOICING & BILLING
// ============================================

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // INV-2024-00001
  bookingId       String        @unique
  
  // Amounts
  subtotal        Decimal       @db.Decimal(10, 2)
  vatRate         Decimal       @db.Decimal(5, 2)
  vatAmount       Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  
  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  paidAmount      Decimal       @db.Decimal(10, 2) @default(0)
  paidAt          DateTime?
  
  // Dates
  issuedAt        DateTime      @default(now())
  dueDate         DateTime
  
  // Metadata
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  booking         Booking       @relation(fields: [bookingId], references: [id])

  @@index([paymentStatus])
  @@index([issuedAt])
  @@map("invoices")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text // JSON string for complex values
  category  String   // general, billing, scheduling, notifications
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType  String   // Booking, Customer, Staff, etc.
  entityId    String?
  oldValue    String?  @db.Text // JSON
  newValue    String?  @db.Text // JSON
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
